---
/**
 * The plant mark (the logo), on the 32px grid, 1.5px round strokes in
 * `currentColor` (`sage-deep` in the header). Paths copied verbatim from the
 * design system (SiteHeader preview).
 *
 * Decorative: always `aria-hidden`; the link around it carries the name.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"svg"> {
  /** Rendered width and height in px (CSS can override). */
  size?: number;
}

const { size = 34, ...attrs } = Astro.props;
---

<svg
  viewBox="0 0 32 32"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  {...attrs}
>
  <path
    d="M17.3175 18.6825C13.3275 12.0312 18.6475 5.38124 29.9537 6.04624C30.625 17.3525 23.9687 22.6725 17.3175 18.6825Z"
  ></path>
  <path
    d="M11.0588 20.0587C13.9088 15.3087 10.1088 10.5587 2.03252 11.0325C1.55752 19.1087 6.30877 22.9087 11.0588 20.0587Z"
  ></path>
  <path d="M7 16L15 24"></path>
  <path
    d="M25 11L17.3438 18.6562C16.6007 19.3991 16.0113 20.2811 15.6091 21.2519C15.207 22.2226 15 23.263 15 24.3137V28"
  ></path>
</svg>
