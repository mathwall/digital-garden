---
/**
 * The end of every page: the rain switch, three vegetables (chili outlined
 * in `beet`, the one decorative exception), the © line with GitHub and
 * LinkedIn, and the mono footnote. Desktop: one row, the switch on the
 * right. The hairline runs edge to edge; the content (`.footer-in`) stays
 * within `page-max`. Ported from the design system (SiteFooter,
 * `bundle.css`) and the desktop mockups.
 */
import { SITE_TITLE, SOCIAL_LINKS } from "../consts";
import RainSwitch from "./RainSwitch.astro";
import Vegetable from "./icons/Vegetable.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-in">
    <RainSwitch class="switch" />
    <div class="veggies" aria-hidden="true">
      <Vegetable name="chili" accent size={30} strokeWidth={1.6} />
      <Vegetable name="blueberries" size={30} strokeWidth={1.6} />
      <Vegetable name="mushroom" size={30} strokeWidth={1.6} />
    </div>
    <span class="copy">
      &copy; {year}
      {SITE_TITLE} · <a class="link" href={SOCIAL_LINKS.github}>GitHub</a> · <a
        class="link"
        href={SOCIAL_LINKS.linkedin}>LinkedIn</a
      >
    </span>
    <span class="note">
      Powered by Astro. Grown in Rennes, watered by the Breton rain.
    </span>
  </div>
</footer>

<style>
  /* The band: the hairline runs edge to edge */
  .footer {
    width: 100%;
    border-top: 1px solid var(--rule);
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }

  .footer-in {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    padding: 20px var(--space-4) 36px;
  }

  .switch {
    align-self: flex-start;
    margin-bottom: 28px;
  }

  .veggies {
    display: flex;
    gap: 10px;
    margin-bottom: var(--space-2);
    color: var(--sage-deep);
  }

  .note {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    color: var(--ink-muted);
  }

  /* Desktop: one row, vegetables + © line + footnote on the left, the rain
     switch on the right, bottoms aligned. Content within page-max, aligned
     with the header and main. */
  @media (min-width: 960px) {
    .footer-in {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "veggies switch"
        "copy switch"
        "note switch";
      align-items: end;
      column-gap: var(--space-6);
      max-width: var(--page-max);
      margin: 0 auto;
      padding: var(--space-5) var(--space-6) var(--space-7);
    }

    .switch {
      grid-area: switch;
      align-self: end;
      margin-bottom: 0;
    }

    .veggies {
      grid-area: veggies;
    }

    .copy {
      grid-area: copy;
    }

    .note {
      grid-area: note;
    }
  }
</style>
