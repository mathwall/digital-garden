---
/**
 * A note's growth stage: a mark grown from the plant logo + the word
 * (Seedling, Budding, Evergreen), in mono capitals, in the stage's colour.
 * The word carries the meaning; the mark is decorative. On note pages only,
 * not on cards. Paths copied verbatim from the design system (GrowthStage
 * preview): Seedling = right leaf + stem, Budding adds the left leaf,
 * Evergreen adds the top bud.
 */
import type { HTMLAttributes } from "astro/types";
import type { GrowthStage } from "../content.config";

interface Props extends HTMLAttributes<"span"> {
  stage: GrowthStage;
}

const { stage, class: className, ...attrs } = Astro.props;

const LABELS: Record<GrowthStage, string> = {
  seedling: "Seedling",
  budding: "Budding",
  evergreen: "Evergreen",
};
---

<span class:list={["stage", `stage--${stage}`, className]} {...attrs}>
  <svg
    viewBox="0 0 32 32"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M17.3 18.7C13.3 12 18.6 5.4 30 6C30.6 17.4 24 22.7 17.3 18.7Z" />
    <path
      d="M25 11L17.3 18.7C16.6 19.4 16 20.3 15.6 21.3C15.2 22.2 15 23.3 15 24.3V28"
    />
    {
      stage !== "seedling" && (
        <>
          <path d="M11.1 20.1C13.9 15.3 10.1 10.6 2 11C1.6 19.1 6.3 22.9 11.1 20.1Z" />
          <path d="M7 16L15 24" />
        </>
      )
    }
    {
      stage === "evergreen" && (
        <>
          <path d="M15 13C12.5 10 12.5 6 15 2.5C17.5 6 17.5 10 15 13Z" />
          <path d="M15 13V21" />
        </>
      )
    }
  </svg>{LABELS[stage]}
</span>

<style>
  .stage {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .stage svg {
    flex: none;
    width: 18px;
    height: 18px;
  }

  .stage--seedling {
    color: var(--stage-seedling);
  }

  .stage--budding {
    color: var(--stage-budding);
  }

  .stage--evergreen {
    color: var(--stage-evergreen);
  }
</style>
