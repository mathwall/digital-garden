---
import NoteListPage from "../../components/NoteListPage.astro";
import { getTopic } from "../../consts";
import { getNotes } from "../../lib/notes";

const topic = getTopic("architecture")!;
const notes = await getNotes(topic);
---

<NoteListPage
  title={topic.name}
  description={`Notes on ${topic.name}, newest first.`}
  permalink={`${Astro.site!.href}${topic.slug}`}
  current={topic.slug}
  label="The garden"
  pageTitle={topic.name}
  notes={notes}
/>
