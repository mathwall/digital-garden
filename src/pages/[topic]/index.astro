---
import NoteListPage from "../../components/NoteListPage.astro";
import { TOPICS, type Topic } from "../../consts";
import { getNotes } from "../../lib/notes";

/** One page per topic of `TOPICS`: `/frontend`, `/architecture`, … */
export function getStaticPaths() {
  return TOPICS.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props as { topic: Topic };
const notes = await getNotes(topic);
---

<NoteListPage
  title={topic.name}
  description={`Notes on ${topic.name}, newest first.`}
  permalink={`${Astro.site!.href}${topic.slug}`}
  current={topic.slug}
  label="The garden"
  pageTitle={topic.name}
  notes={notes}
/>
