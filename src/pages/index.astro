---
import BaseLayout from "../layouts/BaseLayout.astro";
import NoteCardList from "../components/NoteCardList.astro";
import SignOff from "../components/SignOff.astro";
import TopicList from "../components/TopicList.astro";
import Vegetable from "../components/icons/Vegetable.astro";
import { getNotes } from "../lib/notes";

const title = "Home";
const description = "Mathilde's digital garden homepage";
const permalink = Astro.site!.href;

const latestNotes = (await getNotes()).slice(0, 4);
---

<BaseLayout
  title={title}
  description={description}
  permalink={permalink}
  wide
>
  <div class="home">
    <section class="intro" aria-labelledby="welcome">
      <h1 class="greeting" id="welcome">Welcome</h1>
      <p class="intro-text">
        This is my digital garden, where I collect concise notes and
        experiments, from pure CSS to microservices.
      </p>
    </section>

    <section class="fresh" aria-labelledby="fresh-heading">
      <p class="label">From the notebook</p>
      <div class="sechead">
        <h2 id="fresh-heading">Freshly planted</h2>
        <a class="link all-notes" href="/notes">All notes</a>
      </div>
      <NoteCardList notes={latestNotes} layout="pair" />
    </section>

    <div class="ornament" aria-hidden="true">
      <Vegetable name="pea-pod" size={34} strokeWidth={1.5} />
    </div>

    <div class="aside">
      <section class="wander" aria-labelledby="wander-heading">
        <div class="wander-head">
          <p class="label">The garden</p>
          <h2 id="wander-heading">Wander by topic</h2>
        </div>
        <TopicList />
      </section>

      <SignOff />
    </div>
  </div>
</BaseLayout>

<style>
  /* Phone: sections stacked with the mockup's 40px rhythm (`.aside` is only
     a desktop column, its sections stack with the others) */
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .aside {
    display: contents;
  }

  /* ---------- Intro: one handwritten word, one sentence ---------- */
  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .greeting {
    font-family: var(--font-signature);
    font-size: 38px;
    line-height: 46px;
    font-weight: 400;
    letter-spacing: normal;
    color: var(--sage-deep);
  }

  .intro-text {
    font-size: 19px;
    line-height: 29px;
    color: var(--ink);
  }

  /* ---------- Freshly planted ---------- */
  .fresh {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Section head: heading left, "All notes" right, on one baseline */
  .sechead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: var(--measure);
  }

  /* `.link` (global) gives the colour and underline; padding = 44px tap height */
  .all-notes {
    padding: 12px 0;
    font-size: 15px;
    line-height: 20px;
    font-weight: 500;
    white-space: nowrap;
  }

  /* ---------- Pea pod ornament between two hairlines ---------- */
  .ornament {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: var(--measure);
    color: var(--sage-deep);
  }

  .ornament::before,
  .ornament::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--rule);
  }

  .ornament :global(svg) {
    flex: none;
    width: 34px;
    height: 34px;
    stroke-width: 1.5;
  }

  /* ---------- Wander by topic ---------- */
  .wander {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .wander-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  /* Desktop: intro and pea pod across the page, then two columns: the
     latest notes (680px max) | the topics and the sign-off. The side column
     keeps 280px at 960px (the left one shrinks first). */
  @media (min-width: 960px) {
    .home {
      display: grid;
      grid-template-columns: minmax(0, 680px) minmax(280px, 1fr);
      grid-template-areas:
        "intro intro"
        "ornament ornament"
        "fresh aside";
      align-items: start;
      column-gap: var(--space-8);
      row-gap: var(--space-7);
    }

    /* 72px under the header with main's 32px */
    .intro {
      grid-area: intro;
      gap: var(--space-3);
      max-width: var(--measure);
      padding-top: var(--space-7);
    }

    .greeting {
      font-size: 56px;
      line-height: 64px;
    }

    .intro-text {
      font-size: 21px;
      line-height: 32px;
    }

    .ornament {
      grid-area: ornament;
      max-width: none;
    }

    .fresh {
      grid-area: fresh;
      gap: var(--space-3);
    }

    .sechead {
      margin-bottom: var(--space-2);
    }

    .aside {
      grid-area: aside;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    .wander {
      gap: 20px;
    }

    .wander-head {
      gap: var(--space-3);
    }

    /* A size down from the section headings: it sits in the side column */
    .wander h2 {
      font-size: 24px;
      line-height: 30px;
    }
  }
</style>
