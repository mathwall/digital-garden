---
import BaseHead from "../components/BaseHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

export interface Props {
  title: string;
  description: string;
  permalink: string;
  current?: string;
}
const { title, description, permalink, current } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead
      title={title + " - Mathilde Sauvage"}
      description={description}
      permalink={permalink}
    />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="layout">
      <SiteHeader current={current} />

      <main id="content" tabindex="-1">
        <div class="column">
          <slot />
        </div>
      </main>

      <SiteFooter />
    </div>
  </body>
</html>

<style>
  /* "Skip to content": the first thing Tab reaches on every page. Visually
     hidden (like .sr-only) until focused, then shown top-left on
     paper-raised with the global focus ring. */
  .skip {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--paper-raised);
    box-shadow: var(--shadow-lift);
    color: var(--ink);
    font-weight: 650;
  }

  .skip:not(:focus) {
    width: 1px;
    height: 1px;
    min-height: 0;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Reached by the skip link (programmatic focus): no ring around the whole page */
  main:focus {
    outline: none;
  }

  .layout {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* Page frame: `page-max` wide with phone / desktop gutters, content left-aligned in one `measure` column */
  main {
    flex: 1;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-5) var(--space-4) var(--space-7);
    box-sizing: border-box;
  }

  .column {
    max-width: var(--measure);
  }

  @media (min-width: 960px) {
    main {
      padding: var(--space-6) var(--space-6) var(--space-8);
    }
  }
</style>
